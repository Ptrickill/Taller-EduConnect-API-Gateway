          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Evita partir la ventana de minuto fijo: si faltan menos de 20 s para el",
                  "// cambio de minuto, espera al inicio del siguiente.",
                  "const s = new Date().getSeconds();",
                  "if (s > 40) {",
                  "  console.log(`Esperando ${61 - s} s al inicio del siguiente minuto...`);",
                  "  setTimeout(() => {}, (61 - s) * 1000);",
                  "}",
                  "console.log(`[${new Date().toISOString()}] INICIO de la secuencia`);"
                ]
              }
            },
