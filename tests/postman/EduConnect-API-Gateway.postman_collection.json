          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "console.log(`[${new Date().toISOString()}] ${pm.info.requestName} -> ${pm.response.code} | restante/min=${pm.response.headers.get(\"X-RateLimit-Remaining-Minute\")}`);",
                  "pm.test(\"Respondió ms-estudiantes\", () => {",
                  "  pm.expect(pm.response.headers.get(\"X-Servicio-Origen\")).to.eql(\"ms-estudiantes\");",
