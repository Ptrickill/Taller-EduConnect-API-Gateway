              "raw": "{{baseUrl}}/api/pagos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pagos"
              ]
            },
            "description": "ANTES de enviar: docker compose stop ms-pagos. DESPUÉS: docker compose start ms-pagos. 502 = conexión rechazada/inalcanzable; 503 = nombre DNS no resuelto; 504 = timeout de conexión."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de fallo de upstream\", () => pm.expect(pm.response.code).to.be.oneOf([502,503,504]));",
                  "console.log(`[${new Date().toISOString()}] ${pm.info.requestName} -> ${pm.response.code} | restante/min=${pm.response.headers.get(\"X-RateLimit-Remaining-Minute\")}`);"
                ]
